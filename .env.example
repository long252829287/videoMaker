# AI Video Automation System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Debug Mode
# ============================================================
DEBUG=false

# ============================================================
# ComfyUI Configuration
# ============================================================
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ============================================================
# LLM Configuration
# ============================================================
# Provider: anthropic | openai (use "openai" for OpenAI-compatible APIs)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.2

# Generic LLM API Key (preferred, works for any provider)
LLM_API_KEY=sk-jCBa5nUXvgOvNJe5xzcBfAAja7O9QtKeZYvfm9UaxdjBDRPv

# Custom API Base URL (for third-party OpenAI-compatible APIs)
# Examples:
#   GLM-4 (智谱): https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:     https://api.deepseek.com
#   Moonshot:     https://api.moonshot.cn/v1
#   Qwen:         https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.ikuncode.cc/v1

# Provider-specific API Keys (fallback if LLM_API_KEY not set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# TTS Configuration
# ============================================================
# Provider: edge-tts | elevenlabs | gpt-sovits
TTS_PROVIDER=edge-tts
TTS_DEFAULT_VOICE=zh-CN-YunxiNeural

# ElevenLabs (if using)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# GPT-SoVITS (if using)
GPT_SOVITS_HOST=127.0.0.1
GPT_SOVITS_PORT=9880

# ============================================================
# Image Generation
# ============================================================
# Midjourney (if using)
MIDJOURNEY_API_KEY=your_midjourney_api_key_here

# ============================================================
# Video Generation
# ============================================================
# Kling (if using)
KLING_API_KEY=your_kling_api_key_here
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Runway (if using)
RUNWAY_API_KEY=your_runway_api_key_here
